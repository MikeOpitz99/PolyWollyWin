# Python cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# Python packaging
.Python
.eggs/
*.egg
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build artifacts
build/
dist/
builds/
*.manifest
*.pyz

# Logs and temp
*.log
*.tmp
*.pid
temp/
tmp/

# IDE/editor noise
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo

# Windows noise
desktop.ini
Desktop.ini
Thumbs.db

# Packet/device captures
*.pcap
*.pcapng

# Private scripts, protected in case they are accidentally copied into the repo
ReleasePolyWollyWin.bat
build_exe.bat
*_PRIVATE.bat

# IMPORTANT:
# PolyWollyWin.spec and PolyWollyWin.iss are intentionally NOT ignored.
# They belong in the public repo.

# Release binaries belong in GitHub Releases, not Git history
releases/*.exe
releases/*.zip
releases/*.7z
# Python cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# Python packaging
.Python
.eggs/
*.egg
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build artifacts
build/
dist/
builds/
releases/*
!releases/.gitkeep
*.manifest
*.pyz

# Root-level generated release archives and executables
/*.exe
/*.zip
/*.7z

# Logs, temp files, and generated listings
*.log
*.tmp
*.pid
temp/
tmp/
/polywollywindirs.txt

# IDE and editor noise
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo

# Windows noise
desktop.ini
Desktop.ini
Thumbs.db

# Packet and device captures
*.pcap
*.pcapng

# Private scripts, protected in case they are copied into the repo
ReleasePolyWollyWin.bat
build_exe.bat
*_PRIVATE.bat

# Public build configuration
# PolyWollyWin.spec and PolyWollyWin.iss are intentionally not ignored.
